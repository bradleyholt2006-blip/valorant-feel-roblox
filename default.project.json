          "$path": "src/client"
        },
        "RbxCharacterSounds": {
          "$path": "src/overrides/RbxCharacterSounds.client.luau"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    }
  }
}
